{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://openself.dev/spec/context-exchange.schema.json",
    "title": "OpenSelf Context Exchange Format v1",
    "description": "Schema for the openself-context JSONL export. Line 1 is an exportHeader; each subsequent line is a memoryRecord.",
    "$defs": {
        "isoDateTime": {
            "type": "string",
            "format": "date-time",
            "description": "ISO-8601/RFC3339 timestamp, UTC recommended"
        },
        "nullableIsoDateTime": {
            "type": ["string", "null"],
            "format": "date-time"
        },
        "exportHeader": {
            "type": "object",
            "required": [
                "format",
                "version",
                "exportedAt",
                "scope",
                "includeRestricted",
                "count"
            ],
            "properties": {
                "format": { "const": "openself-context" },
                "version": { "const": 1 },
                "exportedAt": { "$ref": "#/$defs/isoDateTime" },
                "generator": { "type": "string", "maxLength": 200 },
                "scope": { "type": ["string", "null"], "maxLength": 200 },
                "includeRestricted": { "type": "boolean" },
                "count": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": true
        },
        "memoryRecord": {
            "type": "object",
            "required": [
                "id",
                "type",
                "content",
                "contentHash",
                "summary",
                "source",
                "scope",
                "sensitivity",
                "sourceTrust",
                "confidence",
                "validFrom",
                "validTo",
                "occurredAt",
                "tags",
                "createdAt",
                "updatedAt"
            ],
            "properties": {
                "id": { "type": "string", "format": "uuid" },
                "type": {
                    "enum": [
                        "fact",
                        "preference",
                        "decision",
                        "commitment",
                        "relationship",
                        "event",
                        "note"
                    ]
                },
                "content": { "type": "string", "minLength": 1, "maxLength": 20000 },
                "contentHash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$",
                    "description": "sha256(\"openself-memory-v1\\n\" + utf8(content))"
                },
                "summary": { "type": "string", "maxLength": 500 },
                "source": {
                    "type": "object",
                    "required": ["kind", "locator", "title"],
                    "properties": {
                        "kind": { "type": "string", "minLength": 1, "maxLength": 50 },
                        "locator": { "type": "string", "maxLength": 2000 },
                        "title": { "type": "string", "maxLength": 300 }
                    },
                    "additionalProperties": true
                },
                "scope": { "type": "string", "minLength": 1, "maxLength": 200 },
                "sensitivity": {
                    "enum": ["public", "personal", "private", "restricted"]
                },
                "sourceTrust": {
                    "enum": ["untrusted", "external", "trusted", "verified", "owner"]
                },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "validFrom": { "$ref": "#/$defs/nullableIsoDateTime" },
                "validTo": { "$ref": "#/$defs/nullableIsoDateTime" },
                "occurredAt": { "$ref": "#/$defs/nullableIsoDateTime" },
                "tags": {
                    "type": "array",
                    "maxItems": 50,
                    "items": { "type": "string", "minLength": 1, "maxLength": 80 }
                },
                "createdAt": { "$ref": "#/$defs/isoDateTime" },
                "updatedAt": { "$ref": "#/$defs/isoDateTime" }
            },
            "additionalProperties": true
        }
    },
    "description": "Validate with $ref #/$defs/exportHeader for line 1 and #/$defs/memoryRecord for each subsequent line."
}
